filters:
  and:
    - file.ext == "md"
formulas:
  seedlingDate: |-
    date("2026-05-03") -
    ((IF(whenToStartOutside>0, whenToStartOutside,whenToStartInside)*7).toString()+" days")
  Plant Date: date("2026-05-03")-((whenToStartOutside*7).toString()+" days")
properties:
  formula.seedlingDate:
    displayName: seedling_date
views:
  - type: table
    name: seed_table
    filters:
      and:
        - "!plantCategory.isEmpty()"
    order:
      - file.name
      - plantCategory
      - sili-seedlingCount
      - quantity
      - whenToStartInside
      - whenToStartOutside
      - formula.seedlingDate
      - formula.Plant Date
      - directSeed
      - plantSeason
      - growthDuration
      - soilTemp
    sort:
      - property: soilTemp
        direction: ASC
      - property: file.name
        direction: ASC
      - property: formula.seedlingDate
        direction: DESC
      - property: whenToStartInside
        direction: DESC
      - property: formula.Untitled
        direction: DESC
      - property: whenToStartOutside
        direction: ASC
    columnSize:
      note.growthDuration: 92
  - type: cards
    name: seed_cards
    filters:
      and:
        - file.tags.contains("plant")
    order:
      - file.name
    image: note.image
    cardSize: 150
    imageAspectRatio: 0.7
  - type: table
    name: View
    filters:
      and:
        - file.ctime >= "2026-07-01"
        - file.ext == "md"
    order:
      - file.name
      - date
      - file.ctime
    sort:
      - property: file.ctime
        direction: ASC
      - property: file.name
        direction: ASC
  - type: list
    name: recent_logs
    filters:
      and:
        - file.tags.contains("log")
        - date > (today() - "60d")
    sort:
      - property: file.name
        direction: DESC
    indentProperties: false
