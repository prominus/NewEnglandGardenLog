filters:
  and:
    - file.ext == "md"
formulas:
  seedlingDate: |-
    date("2026-05-03") -
    ((IF(weeksBeforeFrostDate>0, weeksBeforeFrostDate,sewLastFrostDateDiff)*7).toString()+" days")
  Plant Date: date("2026-05-03")-((weeksBeforeFrostDate*7).toString()+" days")
properties:
  formula.seedlingDate:
    displayName: seedling_date
views:
  - type: table
    name: Table
    filters:
      and:
        - "!plantCategory.isEmpty()"
    order:
      - file.name
      - plantCategory
      - sili-seedlingCount
      - quantity
      - sewLastFrostDateDiff
      - weeksBeforeFrostDate
      - formula.seedlingDate
      - formula.Plant Date
      - directSeed
      - plantSeason
      - growthDuration
    sort:
      - property: file.name
        direction: ASC
      - property: formula.seedlingDate
        direction: DESC
      - property: sewLastFrostDateDiff
        direction: DESC
      - property: formula.Untitled
        direction: DESC
      - property: weeksBeforeFrostDate
        direction: ASC
    columnSize:
      note.growthDuration: 92
  - type: cards
    name: Seed Cards
    filters:
      and:
        - file.tags.contains("plant")
    order:
      - file.name
    image: note.image
